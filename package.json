{
  "name": "co-memo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first memory management across AI agents",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
