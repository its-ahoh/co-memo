  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateContext": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "kind"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "kind": {
            "type": "string",
            "enum": ["note", "preference", "decision", "constraint", "lesson"]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Serialized UTF-8 JSON <=16 KiB; prohibited prototype keys rejected recursively; nesting <=64 levels; NUL and unpaired surrogates rejected."
          }
        }
      },
      "PatchContext": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Serialized UTF-8 JSON <=16 KiB; prohibited prototype keys rejected recursively; nesting <=64 levels; NUL and unpaired surrogates rejected."
          }
        }
      },
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenantId",
          "workspaceId",
          "revision",
          "title",
          "content",
          "kind",
          "metadata",
          "state",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "kind": {
            "type": "string",
            "enum": ["note", "preference", "decision", "constraint", "lesson"]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Serialized UTF-8 JSON <=16 KiB; prohibited prototype keys rejected recursively; nesting <=64 levels; NUL and unpaired surrogates rejected."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "state": {
            "type": "string",
            "enum": ["active"]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "requestId"],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ContextResponse": {
        "type": "object",
        "required": ["requestId", "resource"],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "resource": {
            "$ref": "#/components/schemas/Context"
          }
        }
      },
      "ContextPage": {
        "type": "object",
        "required": ["requestId", "items", "nextCursor"],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Context"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        }
      }
    }
