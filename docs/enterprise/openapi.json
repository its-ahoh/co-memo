{
  "openapi": "3.1.1",
  "info": {
    "title": "Co-memo Enterprise M1",
    "version": "0.1.0",
    "description": "M1 Context API contract. Opt-in development implementation in enterprise/; not production-ready. All writes are automatic submissions; explicit-only workspaces reject them. Bodies <=128 KiB. Text excludes NUL and unpaired surrogates. Scoped bearer auth, per-request authorization, atomic revision/history/receipt/outbox. Later milestones are specified in design.md."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
